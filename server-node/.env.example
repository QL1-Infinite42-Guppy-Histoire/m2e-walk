# M2E Walk server-node — environment configuration.
# Copy to ".env" (chmod 600) and fill in. NEVER commit the real .env.
# The systemd unit in deploy/ loads this file.

# Listen port / address. Keep HOST on localhost: Caddy (or a tunnel)
# terminates HTTPS in front of this process.
PORT=8787
HOST=127.0.0.1

# SQLite database file (created on first start; schema applied automatically).
DB_PATH=/opt/m2e-walk/data/m2e-walk.db

# Required for /admin/* (exchange approval, inventory registration).
# Generate: openssl rand -hex 32
ADMIN_SECRET=

# Base64 of 32 random bytes — AES-GCM key the operator tooling uses to
# encrypt gift codes before registration. The API itself never sees
# plaintext codes.
# Generate: openssl rand -base64 32
GIFT_CODE_KEY=

# AdMob SSV callback. Leave "off" until the app is registered in AdMob
# and the callback URL is set there. Anything other than "true" = disabled
# (/admob/ssv returns 503 and no points can be confirmed).
ADMOB_SSV_ENABLED=off
