# Caddy site for the M2E Walk points server.
# Caddy obtains and renews the TLS certificate automatically (Let's Encrypt)
# as long as the domain's DNS points at this box and ports 80/443 are open.
# Replace the domain, then:  sudo cp this file /etc/caddy/Caddyfile
#                             sudo systemctl reload caddy
walk.example.com {
	reverse_proxy 127.0.0.1:8787
	encode gzip
	log {
		output file /var/log/caddy/m2e-walk.log
	}
}
